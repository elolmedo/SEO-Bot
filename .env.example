# =====================================================================
# SEO Bot - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# =====================================================================

# --- WordPress Credentials ---
USER_WP_PLAGABOT="your_wordpress_username"
PASS_WP_PLAGABOT="your_wordpress_app_password"
URL_WP_PLAGABOT="https://your-domain.com/xmlrpc.php"

# --- Google Cloud Platform (GCP) Configuration ---
PROJECT_ID="your-gcp-project-id"
LOCATION="us-central1"
MODEL_NAME="gemini-2.5-flash"
PROMPT_NAME="Blog_SEO"
BUCKET_NAME="your-gcp-storage-bucket"

# --- AI & External Services ---
OPENAIKEY_PLAGBOT="sk-your-openai-api-key"
ASSITANT_PLAGABOT="asst_your_assistant_id"

# --- Business & SEO Niche Customization ---
BUSINESS_NAME="Your Business Name"
SEO_TARGET_LOCATION="Your Target City or Region"
CATEGORYS_PLAGABOT="Category 1, Category 2, Category 3"
TARGET_URLS="https://your-domain.com/landing-page-1/, https://your-domain.com/contact/"
PRICING_INFO="Service A from 100€, Service B from 250€"

# --- Social Media Integration (Optional) ---
INSTAGRAM_USER="your_instagram_username"
INSTAGRAM_PASS="your_instagram_password"
